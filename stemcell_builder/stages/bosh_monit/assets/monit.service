[Unit]
Description=Monit service
After=network.target bosh-base-firewall.service
Wants=bosh-base-firewall.service
ConditionPathExists=/var/vcap/data/sys/run

[Service]
# Use bosh-agent to add firewall rule allowing this service's cgroup to access monit
ExecStartPre=/var/vcap/bosh/bin/bosh-agent firewall-allow monit
ExecStart=/bin/bash -c 'PATH=/var/vcap/bosh/bin:$PATH exec nice -n -10 /var/vcap/bosh/bin/monit -I -c /var/vcap/bosh/etc/monitrc'
Restart=always
KillMode=process

[Install]
WantedBy=multi-user.target
